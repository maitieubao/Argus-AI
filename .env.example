# Secret dùng để ký session đăng nhập (bắt buộc khi chạy production)
AUTH_SECRET=change-me-to-a-long-random-secret

# Đặt "true" khi chạy sau HTTPS (production). Mặc định để trống/false cho demo localhost HTTP.
# AUTH_COOKIE_SECURE=true

# Cấu hình AI hỗ trợ chấm tự luận theo rubric (E4, best-effort, tùy chọn)
# Nếu không cấu hình, giáo viên vẫn có thể chấm thủ công (fallback minh bạch).
# Hỗ trợ endpoint tương thích OpenAI Chat Completions.
# AI_API_KEY=your-api-key
# AI_MODEL=gpt-4o-mini
# AI_BASE_URL=https://api.openai.com/v1
# (tương thích alias)
# OPENAI_API_KEY=your-api-key
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
